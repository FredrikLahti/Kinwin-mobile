# Copy this file to .env and fill in your local Supabase project's values
# (e.g. from `supabase status` once the local stack is running).
# Never put service_role, provider secrets, or hosted production credentials
# in this file or anywhere in application code — only the public URL and
# anon key belong here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stripe's publishable key is safe for client code (it authorizes nothing by
# itself), but is not consumed anywhere yet: this package is backend-only
# and does not implement PaymentSheet. Reserved for that future client
# package. See supabase/functions/.env.example for the server-side Stripe
# secrets this package's Edge Functions actually use — those must never
# appear here or anywhere client-reachable.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
