# Copy this file to .env and fill in your local Supabase project's values
# (e.g. from `supabase status` once the local stack is running).
# Never put service_role, provider secrets, or hosted production credentials
# in this file or anywhere in application code — only the public URL and
# anon key belong here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public HTTPS origin that serves Expo Router web routes. Required before a
# real recipient invitation can be shared. Never guess or use localhost here.
# Do not include /invite, a token, query, or fragment; the app appends
# /invite/{token} at runtime.
EXPO_PUBLIC_RECIPIENT_INVITATION_BASE_URL=

# Stripe's publishable key is safe for client code (it authorizes nothing by
# itself) — get a test-mode one (pk_test_...) from
# https://dashboard.stripe.com/test/apikeys. Used by app/account/payment-setup.tsx
# to open Stripe's native PaymentSheet. If left empty, payment setup reports
# itself as unavailable and the rest of the app stays usable. See
# supabase/functions/.env.example for the server-side Stripe secrets this
# package's Edge Functions use — those must never appear here or anywhere
# client-reachable.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Real support/contact email address for the "Contact Kinwin" row in Account
# settings (app/account/index.tsx). If left empty, that screen honestly
# reports support as not configured yet rather than showing a fake address.
EXPO_PUBLIC_SUPPORT_EMAIL=
