# Copy this file to supabase/functions/.env (gitignored — see the root
# .gitignore's `.env`/`.env.*` patterns) and fill in Stripe *test mode*
# secrets from https://dashboard.stripe.com/test/apikeys and
# https://dashboard.stripe.com/test/webhooks (or `stripe listen`'s own
# printed secret for local testing — see docs/PAYMENT_SETUP.md).
# `supabase start` loads this file automatically for every local Edge
# Function. Never commit real values, never use live-mode keys here, and
# never put any of these in client code or the root .env.example.

# Secret key (sk_test_...): used server-side only by payment setup, the
# consequence charge worker, and the verified webhook handler.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...): used only by stripe-consequence-webhook
# to verify that an incoming request genuinely came from Stripe before
# trusting or acting on anything in its body.
STRIPE_WEBHOOK_SIGNING_SECRET=

# Tremendous testflight only. The adapter rejects production API origins.
# These values are server-only and must never use an EXPO_PUBLIC_ prefix.
TREMENDOUS_API_BASE_URL=https://testflight.tremendous.com
# Sandbox keys use the TEST_ prefix; non-test keys are rejected.
TREMENDOUS_API_KEY=
TREMENDOUS_FUNDING_SOURCE_ID=
TREMENDOUS_CAMPAIGN_ID=
